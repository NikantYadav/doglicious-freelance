# Backend Dockerfile
FROM node:22-alpine

# Alpine's own Chromium build (compiled for musl — works on Alpine unlike Google's binary)
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

# Point Puppeteer at the system Chromium and skip downloading its own copy
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

WORKDIR /app

COPY server/package*.json ./
RUN npm ci --only=production

COPY server/ ./

EXPOSE 5000
CMD ["node", "index.js"]
