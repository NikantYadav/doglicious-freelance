# --- BACKEND (Server) Configuration ---
# Copy this file to server/.env.backend and fill in your values.

# ── Supabase ──────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Wylto (WhatsApp OTP only — CRM features use Supabase) ────────────
# Wylto API Key — used ONLY for sending WhatsApp OTP messages
# Get this from: https://app.wylto.com → Settings → API Keys
WYLTO_API_KEY=your_wylto_api_key_here

# WhatsApp OTP template name (must be an APPROVED template in your Wylto dashboard)
# The template should have one body variable {{1}} for the OTP code.
WYLTO_OTP_TEMPLATE=vetrx

# Language code for the OTP template (default: en)
WYLTO_OTP_LANGUAGE=en

# Admin phone number (E.164 format) — receives order & subscription notifications via WhatsApp
ADMIN_PHONE=+919889887980

# ── OTP ───────────────────────────────────────────────────────────────
# Secure random string for HMAC OTP token signing — change this in production!
OTP_SECRET=your_secret_random_string_here

# ── AI Provider ───────────────────────────────────────────────────────
# If GEMINI_API_KEY is set, Gemini is used. Otherwise Claude is used.
CLAUDE_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Port (optional, defaults to 5000)
PORT=5000

# ── PayU Payment Gateway ──────────────────────────────────────────────
# Get Key and Salt from: https://dashboard.payu.in → Developers → API Keys
PAYU_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_merchant_salt
PAYU_ENV=test
# test      → https://test.payu.in/_payment
# production → https://secure.payu.in/_payment

PAYU_AMOUNT=99.00
PAYU_PRODUCT=VetRx Scan - Additional Scans Pack

# Number of free scans allowed before paywall
NUM_FREE_SCAN=1

# Number of paid scans to grant after one successful payment
NUM_SCAN=5

# Full URL of this backend server (used to build PayU surl/furl callbacks)
# Local dev:  http://localhost:5000
# Production: https://your-api.vercel.app
SERVER_URL=http://localhost:5000

# Full URL of the frontend app origin (PayU redirects the user back here after payment)
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ── PoopSense Quota Config ────────────────────────────────────────────
# Free trial: number of AI scans allowed during the trial window
PS_TRIAL_SCANS=4
# Free trial: window in days within which trial scans must be used
PS_TRIAL_DAYS=7
# Paid subscription: max AI scans per calendar day
PS_DAILY_CAP=4
# Paid subscription: max total AI scans per subscription period (30 days × 4/day = 120)
PS_PERIOD_CAP=120
# Paid subscription: duration in days
PS_SUB_DAYS=30
# Paid subscription: price in INR (used by PayU checkout)
PS_SUB_PRICE=499
# Paid subscription: product label shown on PayU checkout page
PS_SUB_PRODUCT=PoopSense AI - Monthly Subscription
